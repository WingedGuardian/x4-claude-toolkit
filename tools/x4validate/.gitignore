# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Tool state — these live outside the tree by default (dev\_registry\), but never
# commit one if X4_REGISTRY / X4_EFFECTIVE_DB is ever pointed in here.
*.sqlite
*.sqlite-journal
modlist.yaml
WORKLIST.md

# Real-game-data test corpus: GENERATED (see tests/conftest.py), never committed.
# The toolkit ships no game data — tests skip when the corpus is absent.
tests/corpus/

# Per-mod --update timings for gates/perf_guard.py. MACHINE-LOCAL by design:
# wall-clock differs per machine, so a committed baseline would fail on every
# other setup. Re-record deliberately after an intended perf change.
.perf-baseline.json

# corpus counts depend on installed DLC and modlist, so a committed baseline
# would be wrong for every other machine and fail their first run.
.obtainability-baseline.json

# gates/mutation_probe.py crash-safety artifacts. The marker means the tree MAY BE
# MUTATED right now; the pristine copies are how it recovers without depending on
# `finally` (which does not run on SIGKILL). Neither must ever be committed -- and
# note the mutated SOURCE is a tracked file, so a crashed probe looks like an
# ordinary modification. That is gotcha #27's actual lesson.
.mutation-probe-active
.mutation-probe-pristine/

# behavioural audit: session-history counts for one person on one machine,
# so a committed baseline would be wrong for every other clone.
.toolkit-usage-baseline.json

# Per-command verdicts of gates/hook_false_positives.py over THIS machine's
# Claude Code transcripts. MACHINE-LOCAL by design (the corpus is the user's own
# command history), and ~1-2 MB. Record with --record; compare runs diff against it.
.hook-false-positive-baseline.json
