# --- Local / machine-specific settings (may contain local paths) ---
.claude/settings.local.json
.claude/x4-paths.env
.claude/.reference-buildid

# --- Runtime backups (generated as Claude edits files) ---
.claude/backups/

# ============================================================
# NEVER COMMIT EGOSOFT GAME DATA (copyright) — these are the
# unpacked base game / DLC and packed archives. Redistributing
# them violates Egosoft's terms and will get the repo removed.
# ============================================================
reference/
extensions/
*.cat
*.dat
*.sig
lang.dat
X4.exe

# --- Never commit saves / profile / logs ---
save/
*.xml.gz
debug.txt
content.xml
config.xml

# --- Python (x4validate) ---
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Node ---
node_modules/

# --- OS noise ---
Thumbs.db
Desktop.ini
.DS_Store

# Per-mod --update timings for gates/perf_guard.py — MACHINE-LOCAL by design
# (wall-clock differs per machine; a committed baseline would fail everywhere else)
tools/x4validate/.perf-baseline.json

# gates/mutation_probe.py crash-safety artifacts (see tools/x4validate/gates/).
# The marker means the tree MAY BE MUTATED right now; the pristine copies are how
# it recovers without depending on `finally`, which does not run on SIGKILL.
tools/x4validate/.mutation-probe-active
tools/x4validate/.mutation-probe-pristine/
