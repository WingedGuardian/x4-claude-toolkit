# --- Local / machine-specific settings (may contain local paths) ---
# Per-machine, and their BACKUPS. The two names were pinned exactly, so the
# .bak-<stamp> files write_paths_env leaves beside them were not ignored at all --
# and the carry-over deliberately preserves X4_NEXUS_KEY into every rewrite, so each
# backup holds the key plus that machine's absolute paths. They showed up in
# `git status`, where a `git add -A` would have taken them.
#
# Explicit .bak-* rather than a blanket x4-paths.env*, which would also stop
# tracking the .example template the installer ships.
.claude/settings.local.json
.claude/settings.local.json.bak-*
.claude/x4-paths.env
.claude/x4-paths.env.bak-*
.claude/.reference-buildid

# --- Runtime backups (generated as Claude edits files) ---
.claude/backups/

# ============================================================
# NEVER COMMIT EGOSOFT GAME DATA (copyright) — these are the
# unpacked base game / DLC and packed archives. Redistributing
# them violates Egosoft's terms and will get the repo removed.
# ============================================================
reference/
extensions/
*.cat
*.dat
*.sig
lang.dat
X4.exe

# --- Never commit saves / profile / logs ---
save/
*.xml.gz
debug.txt
content.xml
config.xml
# ...but the toolkit SHIPS a game extension, and an X4 extension without its manifest
# does not load AT ALL -- silently, with no error line anywhere. MEASURED 2026-09-01:
# `git archive HEAD mods/` listed 3 files and no content.xml, so every install from a
# release tarball would have carried a dead mod. The broad ignore above stays as
# defence for anyone who copies a profile into the tree; this exempts only our own.
!mods/**/content.xml

# --- Python (x4validate) ---
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Node ---
node_modules/

# --- OS noise ---
Thumbs.db
Desktop.ini
.DS_Store

# Per-mod --update timings for gates/perf_guard.py — MACHINE-LOCAL by design
# (wall-clock differs per machine; a committed baseline would fail everywhere else)
tools/x4validate/.perf-baseline.json

# gates/mutation_probe.py crash-safety artifacts (see tools/x4validate/gates/).
# The marker means the tree MAY BE MUTATED right now; the pristine copies are how
# it recovers without depending on `finally`, which does not run on SIGKILL.
tools/x4validate/.mutation-probe-active
tools/x4validate/.mutation-probe-pristine/

# hook test sandbox (scripts/test-hooks.sh)
.test-sandbox/

# Release bundles built by scripts/build-release.sh. Derived from a git ref, so
# committing one would store the same bytes twice and let a stale copy sit beside
# a moved tag.
dist/
